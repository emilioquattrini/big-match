{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "types": ["vite/client", "node"],
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "tests/*.test.ts", "vite.config.ts"]
}
