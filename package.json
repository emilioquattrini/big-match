{
  "name": "big-match",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --project supabase/functions/big-match/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts tests/backend/*.test.mjs",
    "test:sw": "node --test tests/e2e/service-worker.test.mjs",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "build": "npm run typecheck && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check:release": "node scripts/check-release.mjs",
    "catalog:sql": "node scripts/catalog-sql.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
