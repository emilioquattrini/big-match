# SERVER ONLY. Copy to an untracked secrets file, never into VITE_* variables.
# Hosted Supabase injects SUPABASE_URL and SUPABASE_SECRET_KEYS (JSON/default).
# Configure only the two BIG_MATCH_* values below in hosted secrets management.
# SUPABASE_ is a reserved prefix: do not upload entries with it as hosted secrets.
# Local/self-hosted runtime only: uncomment and set these if needed.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# Reference: https://supabase.com/docs/guides/functions/secrets
BIG_MATCH_ALLOWED_ORIGINS=https://emilioquattrini.github.io
# Generate a random value with at least 32 characters, used only on the server.
BIG_MATCH_RATE_LIMIT_SECRET=
